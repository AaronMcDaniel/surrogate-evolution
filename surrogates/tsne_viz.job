#!/bin/bash
#SBATCH --job-name=tsne_viz
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64GB
#SBATCH --time=02:00:00
#SBATCH --output=/storage/ice-shared/vip-vvk/data/AOT/%u/codestral/tsne_visualizations/tsne_viz.%j.log
#SBATCH --error=/storage/ice-shared/vip-vvk/data/AOT/%u/codestral/tsne_visualizations/tsne_viz_error.%j.log

module load anaconda3/2023.03

# Create output directory
mkdir -p /storage/ice-shared/vip-vvk/data/AOT/%u/codestral/tsne_visualizations

# Run the visualization script
conda run -n nas --no-capture-output python -u /home/hice1/%u/scratch/surrogate-evolution/surrogates/visualize_tsne.py \
    --input /storage/ice-shared/vip-vvk/data/AOT/psomu3/codestral/codestral_reg_val_reduced.pkl \
    --output_dir /storage/ice-shared/vip-vvk/data/AOT/%u/codestral/tsne_visualizations \
    --perplexity 30 \
    --n_iter 1000 \
    --classification True

echo "t-SNE visualization completed!"
    # --input /storage/ice-shared/vip-vvk/data/AOT/%u/codestral/codestral_reg_val.pkl \

#to run sbatch #path to file
